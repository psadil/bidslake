          "surface_mapped_scalars": {
            "selectors": [
              "dataset.dataset_description.DatasetType == 'derivative'"
            ],
            "entities": {
              "ceagent": "optional",
              "reconstruction": "optional",
              "chunk": "optional",
              "acquisition": "optional",
              "run": "optional",
              "subject": "required",
              "session": "optional"
            },
            "suffixes": [
              "curv",
              "thickness",
              "area",
              "dist",
              "defects",
              "sulc",
              "T1wT2wratio",
              "distortion"
            ],
            "extensions": [
              ".json"
            ]
          },
          "surface_mapped_scalars_giftis": {
            "selectors": [
              "dataset.dataset_description.DatasetType == 'derivative'"
            ],
            "entities": {
              "ceagent": "optional",
              "reconstruction": "optional",
              "chunk": "optional",
              "acquisition": "optional",
              "run": "optional",
              "subject": "required",
              "session": "optional",
              "hemisphere": "required"
            },
            "suffixes": [
              "curv",
              "thickness",
              "area",
              "dist",
              "defects",
              "sulc",
              "T1wT2wratio",
              "distortion"
            ],
            "extensions": [
              ".json",
              ".shape.gii"
            ]
          },
          "surface_mapped_scalars_ciftis": {
            "selectors": [
              "dataset.dataset_description.DatasetType == 'derivative'"
            ],
            "entities": {
              "ceagent": "optional",
