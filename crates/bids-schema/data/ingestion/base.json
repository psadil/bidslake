{
  "IngestionSchemaVersion": "0.1.0",
  "rules": [
    { "selectors": ["intersects([extension], [\".bval\", \".bvec\"])"], "disposition": "read", "reader": "diffusion" },
    { "selectors": ["extension == \".tsv.gz\""], "disposition": "catalog" },
    { "selectors": ["extension == \".tsv\""], "disposition": "read", "reader": "csv" }
  ],
  "tables": {
    "events": { "ordered": false, "describes": { "association": "events" } },
    "asl_context": {
      "describes": { "association": "aslcontext", "axis": "volume", "view": "asl_volumes" }
    },
    "bvals": { "describes": { "association": "bval", "axis": "volume", "view": "bval_volumes" } },
    "bvecs": { "describes": { "association": "bvec", "axis": "volume", "view": "bvec_volumes" } }
  }
}
